{
  "schema": 1,
  "version": 2,
  "presets": [
    {
      "id": "retroarch",
      "name": "RetroArch",
      "verified": false,
      "systems": {
        "nes": {"cores": ["mesen", "fceumm", "nestopia", "quicknes"], "extensions": ["nes", "fds", "unf", "zip"]},
        "snes": {"cores": ["snes9x", "snes9x2010", "bsnes"], "extensions": ["sfc", "smc", "fig", "bs", "zip"]},
        "gb": {"cores": ["gambatte", "sameboy", "gearboy", "mgba"], "extensions": ["gb", "zip"]},
        "gbc": {"cores": ["gambatte", "sameboy", "mgba"], "extensions": ["gbc", "zip"]},
        "gba": {"cores": ["mgba", "vba_next", "gpsp"], "extensions": ["gba", "zip"]},
        "nds": {"cores": ["melonds", "desmume"], "extensions": ["nds", "zip"]},
        "3ds": {"cores": ["citra"], "extensions": ["3ds", "cci", "cxi"]},
        "n64": {"cores": ["mupen64plus_next_gles3", "parallel_n64"], "extensions": ["n64", "z64", "v64", "zip"]},
        "gamecube": {"cores": ["dolphin"], "extensions": ["iso", "gcm", "rvz", "gcz", "ciso", "m3u"]},
        "wii": {"cores": ["dolphin"], "extensions": ["iso", "wbfs", "rvz", "gcz"]},
        "psx": {"cores": ["swanstation", "pcsx_rearmed", "mednafen_psx_hw"], "extensions": ["chd", "cue", "pbp", "m3u", "iso"]},
        "ps2": {"cores": ["pcsx2"], "extensions": ["chd", "iso"]},
        "psp": {"cores": ["ppsspp"], "extensions": ["iso", "cso", "chd", "pbp"]},
        "genesis": {"cores": ["genesis_plus_gx", "picodrive"], "extensions": ["md", "gen", "smd", "bin", "zip"]},
        "saturn": {"cores": ["mednafen_saturn", "yabasanshiro"], "extensions": ["chd", "cue", "m3u"]},
        "dreamcast": {"cores": ["flycast"], "extensions": ["chd", "gdi", "cdi", "m3u"]},
        "arcade": {"cores": ["fbneo", "mame2003_plus", "mamearcade"], "extensions": ["zip", "7z"]}
      },
      "android": {
        "packages": ["com.retroarch.aarch64", "com.retroarch", "com.retroarch.ra32"],
        "activity": "com.retroarch.browser.retroactivity.RetroActivityFuture",
        "action": "android.intent.action.MAIN",
        "rom": {"mode": "path", "scopedMode": "saf", "extra": "ROM"},
        "extras": [{"key": "LIBRETRO", "type": "string", "value": "{retroarch.core}"}, {"key": "CONFIGFILE", "type": "string", "value": "{retroarch.config}"}],
        "flags": ["clearTask", "clearTop"]
      },
      "linux": {
        "find": [
          {"type": "path", "names": ["retroarch"]},
          {"type": "flatpak", "id": "org.libretro.RetroArch"},
          {"type": "static", "paths": ["~/Applications/RetroArch-Linux*.AppImage"]}
        ],
        "args": ["-L", "{retroarch.core}", "{rom}"]
      },
      "windows": {
        "find": [
          {"type": "static", "paths": ["%APPDATA%\\RetroArch\\retroarch.exe", "C:\\RetroArch-Win64\\retroarch.exe"]},
          {"type": "path", "names": ["retroarch.exe"]}
        ],
        "args": ["-L", "{retroarch.core}", "{rom}"]
      },
      "macos": {"find": [{"type": "app", "paths": ["/Applications/RetroArch.app"]}], "args": ["-L", "{retroarch.core}", "{rom}"]}
    },
    {
