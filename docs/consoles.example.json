[
  {
    "name": "Example HTML Index Console",
    "url": "https://example.com/roms/example-console/",
    "file_format": [".ext"],
    "roms_folder": "example",
    "boxarts": "https://example.com/boxarts/example-console/",
    "should_unzip": true,
    "extract_contents": true
  },
  {
    "name": "Example Internet Archive Console",
    "url": [
      "https://archive.org/download/example-item-part1/",
      "https://archive.org/download/example-item-part2/"
    ],
    "file_format": [".iso"],
    "roms_folder": "example-ia",
    "boxarts": {
      "url": "https://example.com/maps/example.json",
      "name": "name",
      "id": "serial",
      "image": "https://example.com/covers/{serial}.png"
    },
    "should_unzip": false
  },
  {
    "name": "Example Authenticated Console",
    "url": "https://api.example.com/games/?limit=1000",
    "regex": "\"(?P<id>[A-Z0-9]+)\"\\s*:\\s*\\{.*?\"name\"\\s*:\\s*\"(?P<text>[^\"]+)\".*?\"icon_url\"\\s*:\\s*\"(?P<banner_url>[^\"]+)\"",
    "file_format": [".ext"],
    "roms_folder": "example-auth",
    "download_url": "https://api.example.com/games/download/<id>",
    "ignore_extension_filtering": true,
    "should_decompress_nsz": false,
    "auth": {
      "cookies": true,
      "cookie_name": "auth_token",
      "token": "",
      "auth_message": "Instructions shown to the user for obtaining a token.",
      "signin": {
        "register_url": "https://example.com/register",
        "url": "https://api.example.com/auth/login",
        "method": "POST",
        "params": ["username", "password"],
        "token_regex": "\"access_token\"\\s*:\\s*\"([^\"]+)\""
      }
    }
  }
]
